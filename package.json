{
  "name": "playwright-ts-framework",
  "version": "1.0.0",
  "description": "Scalable Playwright + TypeScript framework: Page Object Model, custom fixtures, API testing, multi-env config and CI",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "lint": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "author": "Santhosh Kumar",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
